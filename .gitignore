# One .gitignore for the whole repository (all services)

# Local secrets
.env
# JWT signing keys of api-management-service (real keys never leave the machine)
**/src/main/resources/certs/*.pem

# Personal design notes
DESIGN_DECISIONS.txt

# Build output
node_modules/
*.log
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/
.mvn/wrapper/maven-wrapper.jar

# Generated by Spring Initializr
HELP.md

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/
