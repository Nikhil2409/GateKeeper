# Optional settings for docker compose. Every value has a working default, so the stack runs without a .env file.
# To change them: copy this file to .env (never commit .env) and edit. Single quotes keep "$" literal.

# MySQL root password (MySQL publishes no port; only api-management connects to it)
DB_PASSWORD=gatekeeper-demo

# The platform admin. Default login: platform-admin / admin-pass-123.
# For your own password, put its BCrypt hash here, e.g. generated with:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD_HASH='$2a$10$QEpTD0pPcs/oy/e1OkYAQOD7o5Fzhw6ekg3ZsahWQUzIgrdjVZfXy'

# Grafana's own admin (its login form is off; platform admins open it through analytics-ui)
GRAFANA_ADMIN_PASSWORD=gatekeeper-demo

# Only for the load test (loadtest/): the platform admin k6 logs in as. Keep in sync with the hash above.
LOADTEST_ADMIN_USERNAME=platform-admin
LOADTEST_ADMIN_PASSWORD=admin-pass-123
